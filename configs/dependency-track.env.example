# AI Sentinel — Dependency-Track Configuration
# Copy to dependency-track.env and fill in your values.
# This file is gitignored — never commit actual credentials.

# Dependency-Track server URL
DT_URL=https://dependency-track.example.com

# API key (generate from Administration → Access Management → Teams)
DT_API_KEY=your-api-key-here

# Project UUID (find in Project → Properties)
DT_PROJECT_UUID=your-project-uuid-here
